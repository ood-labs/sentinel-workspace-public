int scientificaRowForFace(int face, int code, int row) {
    if (code < SCIENTIFICA_FIRST || code > SCIENTIFICA_LAST || row < 0 || row >= SCIENTIFICA_GLYPH_H) return 0;
    int i = code - SCIENTIFICA_FIRST;
    if (face == 0) {
        if (row == 0) return SCI_REGULAR_ROW_0[i];
        if (row == 1) return SCI_REGULAR_ROW_1[i];
        if (row == 2) return SCI_REGULAR_ROW_2[i];
        if (row == 3) return SCI_REGULAR_ROW_3[i];
        if (row == 4) return SCI_REGULAR_ROW_4[i];
        if (row == 5) return SCI_REGULAR_ROW_5[i];
        if (row == 6) return SCI_REGULAR_ROW_6[i];
        if (row == 7) return SCI_REGULAR_ROW_7[i];
        if (row == 8) return SCI_REGULAR_ROW_8[i];
        if (row == 9) return SCI_REGULAR_ROW_9[i];
        if (row == 10) return SCI_REGULAR_ROW_10[i];
    }
    else if (face == 1) {
        if (row == 0) return SCI_BOLD_ROW_0[i];
        if (row == 1) return SCI_BOLD_ROW_1[i];
        if (row == 2) return SCI_BOLD_ROW_2[i];
        if (row == 3) return SCI_BOLD_ROW_3[i];
        if (row == 4) return SCI_BOLD_ROW_4[i];
        if (row == 5) return SCI_BOLD_ROW_5[i];
        if (row == 6) return SCI_BOLD_ROW_6[i];
        if (row == 7) return SCI_BOLD_ROW_7[i];
        if (row == 8) return SCI_BOLD_ROW_8[i];
        if (row == 9) return SCI_BOLD_ROW_9[i];
        if (row == 10) return SCI_BOLD_ROW_10[i];
    }
    else if (face == 2) {
        if (row == 0) return SCI_ITALIC_ROW_0[i];
        if (row == 1) return SCI_ITALIC_ROW_1[i];
        if (row == 2) return SCI_ITALIC_ROW_2[i];
        if (row == 3) return SCI_ITALIC_ROW_3[i];
        if (row == 4) return SCI_ITALIC_ROW_4[i];
        if (row == 5) return SCI_ITALIC_ROW_5[i];
        if (row == 6) return SCI_ITALIC_ROW_6[i];
        if (row == 7) return SCI_ITALIC_ROW_7[i];
        if (row == 8) return SCI_ITALIC_ROW_8[i];
        if (row == 9) return SCI_ITALIC_ROW_9[i];
        if (row == 10) return SCI_ITALIC_ROW_10[i];
    }
    return 0;
}
