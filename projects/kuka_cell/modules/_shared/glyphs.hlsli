// glyphs.hlsli — letter indices into microfont's glyph table, so label code reads as words.
// Generic infrastructure, vendored with the font it indexes.
#ifndef KA_GLYPHS_HLSLI
#define KA_GLYPHS_HLSLI

#define LA 10u
#define LB 11u
#define LC 12u
#define LD 13u
#define LE 14u
#define LF 15u
#define LG 16u
#define LH 17u
#define LI 18u
#define LJ 19u
#define LK 20u
#define LL 21u
#define LM 22u
#define LN 23u
#define LO 24u
#define LP 25u
#define LQ 26u
#define LR 27u
#define LS 28u
#define LT 29u
#define LU 30u
#define LV 31u
#define LW 32u
#define LX 33u
#define LY 34u
#define LZ 35u

#endif
