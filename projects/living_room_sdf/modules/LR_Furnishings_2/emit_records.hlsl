[numthreads(64, 1, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= kRecordCount) return;
    uint i = id.x;
    PNode r = kRecords[i];

    // One global transform at the generator boundary, then semantic sub-layouts.
    r.position.x += layout_offset.x;
    r.position.z += layout_offset.y;

    bool seatingRecord = i <= 6 || (i >= 12 && i <= 13) || (i >= 16 && i <= 19);
    if (seatingRecord) {
        float2 center = float2(-0.45, 1.20) + layout_offset;
        r.position.xz = center + (r.position.xz - center) * seating_spread;
    }

    if (i == 0 || (i >= 16 && i <= 18)) {
        r.position.xz += sofa_offset;
    }
    if (i == 1) {
        r.position.xz += left_chair_offset;
        r.yaw = left_chair_yaw;
    }
    if (i == 2) {
        r.position.xz += right_chair_offset;
        r.yaw = right_chair_yaw;
    }
    if (i == 3 || i == 19) {
        r.position.xz += coffee_table_offset;
        if (i == 3) r.yaw = coffee_table_yaw;
    }
    if (i >= 7 && i <= 11 || i >= 20 && i <= 22) {
        r.position.xz += media_wall_offset;
    }
    if (i == 14 || i == 15) {
        float plantCenterX = -0.40 + layout_offset.x;
        r.position.x = plantCenterX + (r.position.x - plantCenterX) * plant_spread;
        r.position.z += plant_depth_offset;
    }

    // Local +Z transformed into world X/Z by the same yaw convention as the renderer.
    r.dir = float2(-sin(r.yaw), cos(r.yaw));
    OutputBuffer[i] = r;
}
