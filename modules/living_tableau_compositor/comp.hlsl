RWTexture2D<float4>OutputUAV:register(u0);
float3 overAdd(float3 dst,float4 src,float gain){return dst+src.rgb*gain;}
[numthreads(8,8,1)]void main(uint3 id:SV_DispatchThreadID){if(id.x>=(uint)_Resolution.x||id.y>=(uint)_Resolution.y)return;float2 uv=((float2)id.xy+.5)/_Resolution.xy;float vign=smoothstep(.82,.15,length(uv-.5));float3 col=background_color*(.18+.28*vign);if(show_lattice!=0)col=overAdd(col,_Tex1.SampleLevel(LinearSampler,uv,0),lattice_gain);if(show_signal!=0)col=overAdd(col,_Tex2.SampleLevel(LinearSampler,uv,0),signal_gain);if(show_neural!=0)col=overAdd(col,_Tex0.SampleLevel(LinearSampler,uv,0),neural_gain);if(show_orbit!=0)col=overAdd(col,_Tex3.SampleLevel(LinearSampler,uv,0),orbit_gain);col=1-exp(-col*exposure);col=pow(saturate(col),1.0/max(gamma,0.2));OutputUAV[id.xy]=float4(col,1);}
