RWTexture2D<float4> OutputUAV:register(u0);
float seg(float2 p,float2 a,float2 b,float w){float2 q=p-a,r=b-a;float h=saturate(dot(q,r)/max(dot(r,r),1e-5));return 1-smoothstep(w*.35,w,length(q-r*h));}
float rect(float2 p,float2 a,float2 b,float w){return max(seg(p,a,float2(b.x,a.y),w),max(seg(p,float2(b.x,a.y),b,w),max(seg(p,b,float2(a.x,b.y),w),seg(p,float2(a.x,b.y),a,w))));}
[numthreads(8,8,1)] void main(uint3 tid:SV_DispatchThreadID){if(tid.x>=(uint)_Resolution.x||tid.y>=(uint)_Resolution.y)return;float2 uv=((float2)tid.xy+.5)/_Resolution.xy;float3 base=_Tex0.SampleLevel(LinearSampler,uv,0).rgb;float2 p=(uv-float2(.12,.55))/float2(.20,.39);float panel=1-smoothstep(.98,1.0,max(abs(p.x),abs(p.y)));float2 q=p;float h=_Tex1.SampleLevel(LinearSampler,saturate(uv),0).r;float ridge=_Tex2.SampleLevel(LinearSampler,saturate(uv),0).r;float3 ink=0;float border=rect(p,float2(-.94,-.94),float2(.94,.94),.0035);float divider=0;for(int k=0;k<3;k++){float y=-.62+k*.62;float2 s=q-float2(0,y);float band=1-smoothstep(.28,.34,abs(s.y));float2 warped=s;float variant=(float)k;warped.x+=sin((s.y+variant*.7+slice_phase)*18.0)*displacement*(.4+.3*variant);warped.y+=cos((s.x+slice_phase)*13.0)*displacement*.35;float z=_Tex1.SampleLevel(LinearSampler,saturate(uv+warped*float2(.025,.018)),0).r;float scan=abs(frac((warped.x+variant*.21+slice_phase)*11.0)-.5);float contour=1-smoothstep(.018,.002,abs(frac(z*(5.0+variant*3.0))-0.5));float ribs=1-smoothstep(.012,.002,abs(frac((warped.x+warped.y)*(.0+18.0+variant*7.0))-0.5));float edge=saturate(ridge*ridge_gain*2.0);float pulse=smoothstep(.48,.5,frac(slice_phase+variant*.23));ink+=band*(paper_color.rgb*(contour*.62+ribs*.22+scan*.08)+accent_color.rgb*edge*.26);divider=max(divider,band*scan*.2);}float tick=0;for(int i=0;i<9;i++){float x=-.82+i*.205;tick=max(tick,seg(p,float2(x,.91),float2(x,.84),.003));}float3 outc=base+ink*panel*atlas_gain+paper_color.rgb*(border+tick+divider)*panel*.6;outc+=accent_color.rgb*panel*divider*.25;OutputUAV[tid.xy]=float4(saturate(outc),1);}
