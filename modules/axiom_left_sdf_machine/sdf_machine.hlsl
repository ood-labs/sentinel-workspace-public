float sdBox(float3 p,float3 b){float3 d=abs(p)-b;return length(max(d,0))+min(max(d.x,max(d.y,d.z)),0);}
float sdCaps(float3 p,float2 h){p.y=abs(p.y)-h.y;return length(float2(max(abs(p.x)-h.x,0),p.y))-h.x*.18;}
float sdRing(float2 p,float r,float t){return abs(length(p)-r)-t;}
float line2(float2 p,float2 a,float2 b,float w){float2 q=p-a,r=b-a;float h=saturate(dot(q,r)/max(dot(r,r),1e-5));return abs(length(q-r*h)-w);}
float scene(float3 p,uint nc,uint ec){float d=9;d=min(d,sdBox(p-float3(-.38,0,.0),float3(.12,.34,.08)));d=min(d,sdBox(p-float3(.18,.0,.02),float3(.08,.22,.06)));d=min(d,sdCaps(p-float3(-.04,.05,.01),float2(.24,.12)));d=min(d,abs(length(p-float3(.0,.0,.05))-(.26+.03*sin(machine_phase*6.28+nc*.08)))-.018);d=min(d,sdBox(p-float3(.0,-.29,-.01),float3(.34,.025,.045)));return d;}
[numthreads(8,8,1)] void main(uint3 tid:SV_DispatchThreadID){if(tid.x>=(uint)_Resolution.x||tid.y>=(uint)_Resolution.y)return;float2 uv=((float2)tid.xy+.5)/_Resolution.xy;float3 c=_Tex0.SampleLevel(LinearSampler,uv,0).rgb;float2 q=(uv-float2(.13,.55))/float2(.22,.40);float bay=1-smoothstep(.96,1.0,max(abs(q.x),abs(q.y)));uint nc=min(_Data0_Count,64u),ec=min(_Data1_Count,64u);float w=0,e=0;for(uint i=0;i<nc;i++)if(_Data0[i].active>.5)w+=_Data0[i].weight;for(uint j=0;j<ec;j++)if(_Data1[j].active>.5)e+=_Data1[j].energy;float relief=_Tex1.SampleLevel(LinearSampler,saturate(uv),0).r;float3 ro=float3(q.x,q.y,2.2),rd=float3(0,0,-1);float t=0,d=0;for(int k=0;k<40;k++){float3 pos=ro+rd*t;d=scene(pos,nc,ec);t+=d*.55;if(d<.002||t>4)break;}float hit=1-smoothstep(.002,.012,d);float3 n=normalize(float3(scene(ro+float3(.003,0,0),nc,ec)-d,scene(ro+float3(0,.003,0),nc,ec)-d,.003));float3 light=normalize(float3(-.5,.6,1));float shade=saturate(dot(n,light))*.65+.35;float contour=1-smoothstep(.003,.018,abs(frac(t*4.0+relief*relief_mix)-.5));float route=0;for(uint r=0;r<nc;r++){if(_Data0[r].active<.5)continue;float2 a=(_Data0[r].position-.5)*float2(1.7,1.0);route=max(route,1-smoothstep(.002,.014,min(line2(q,a,float2(a.x,0),.006),line2(q,float2(a.x,0),float2(0,a.y),.006))));}float tech=0; tech=max(tech,1-smoothstep(.012,.003,abs(abs(q.x)-.88))); tech=max(tech,1-smoothstep(.012,.003,abs(abs(q.y)-.90))); tech=max(tech,1-smoothstep(.010,.003,abs(frac(q.x*12.0)-.5))); tech=max(tech,1-smoothstep(.010,.003,abs(frac(q.y*14.0)-.5))); tech=max(tech,1-smoothstep(.012,.003,abs(q.x))); tech=max(tech,1-smoothstep(.012,.003,abs(q.y))); float2 c0=float2(-.78,.78); tech=max(tech,1-smoothstep(.014,.003,length(q-c0))); tech=max(tech,1-smoothstep(.014,.003,length(q+float2(.78,-.78)))); float3 ink=paper_color.rgb*(hit*shade+contour*.3+route*.35)*machine_gain;ink+=accent_color.rgb*saturate(e/max((float)ec,1.0))*route*.55; c+=ink*bay;OutputUAV[tid.xy]=float4(saturate(c),1);}


