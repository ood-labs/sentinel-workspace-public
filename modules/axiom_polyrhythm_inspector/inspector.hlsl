RWTexture2D<float4> OutputUAV:register(u0);
float ln(float2 p,float2 a,float2 b,float w){float2 q=p-a,r=b-a;float h=saturate(dot(q,r)/max(dot(r,r),1e-5));return 1-smoothstep(w*.35,w,length(q-r*h));}
float frame(float2 p,float2 a,float2 b){return max(ln(p,a,float2(b.x,a.y),.002),max(ln(p,float2(b.x,a.y),b,.002),max(ln(p,b,float2(a.x,b.y),.002),ln(p,float2(a.x,b.y),a,.002))));}
float meter(float2 p,float v){return 1-smoothstep(.003,.012,abs(p.y-v));}
[numthreads(8,8,1)]void main(uint3 tid:SV_DispatchThreadID){if(tid.x>=(uint)_Resolution.x||tid.y>=(uint)_Resolution.y)return;float2 uv=((float2)tid.xy+.5)/_Resolution.xy;float3 c=_Tex0.SampleLevel(LinearSampler,uv,0).rgb;float2 q=(uv-float2(.13,.55))/float2(.22,.40);float bay=1-smoothstep(.98,1.0,max(abs(q.x),abs(q.y)));float3 ink=0;float2 cell=float2(.88,.16);for(int i=0;i<10;i++){float col=i%2,row=i/2;float2 cc=float2(-.43+col*.43,.72-row*.18);float2 p=(q-cc)/float2(.38,.13);float f=frame(p,float2(-.94,-.86),float2(.94,.86));float v=0;if(i==0)v=phase;if(i==1)v=(sine+1)*.5;if(i==2)v=tri;if(i==3)v=pulse;if(i==4)v=drift;if(i==5)v=envelope;if(i==6)v=saturate(blob_count/24);if(i==7)v=saturate(corner_count/128);if(i==8)v=edge_density;if(i==9)v=saturate(abs(dominant_angle)/3.14);float target=.0; if(i==0) target=.45*sin(p.x*10+phase*6.28)*.28+v*.42; else if(i==1) target=(frac(p.x*2.5+phase)-.5)*.7+v*.35; else if(i==2) target=(p.x>v-.5)? .34:-.34; else if(i==3) target=sin(p.x*18+drift*8)*.18+cos(p.y*18)*.12; else if(i==4) target=v*.65-.32; else if(i==5) target=exp(-abs(p.x)*2.4)*v-.32; else if(i==6) target=(frac(p.x*10)<v)? .34:-.34; else if(i==7) target=(length(p-float2(0,0))<.2+v*.3)? .34:-.34; else if(i==8) target=(frac(p.x*14)<v*.7)? .34:-.34; else target=sin(p.x*6+dominant_angle)*.22+v*.25; float wave=abs(p.y-target);float scope=1-smoothstep(.008,.045,wave);float bar=meter(float2(p.x,p.y),v*.7-.35);ink+=paper_color.rgb*(f*.6+scope*.9+bar*.8);if(i==3||i==8)ink+=accent_color.rgb*scope*.7;}float outer=frame(q,float2(-.95,-.95),float2(.95,.95));ink+=paper_color.rgb*outer*.7;float ret=ln(q,float2(-.08,0),float2(.08,0),.002)+ln(q,float2(0,-.08),float2(0,.08),.002);ink+=accent_color.rgb*ret*.55;c+=ink*bay*.22;OutputUAV[tid.xy]=float4(saturate(c),1);}




