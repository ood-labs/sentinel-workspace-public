struct PrimitiveRecord { float2 p0; float2 p1; float3 color; float width; float kind; float group_id; float route_t; float active; };
RWTexture2D<float4>OutputUAV:register(u0);
float sdSeg(float2 p,float2 a,float2 b){float2 pa=p-a,ba=b-a;return length(pa-ba*saturate(dot(pa,ba)/max(dot(ba,ba),1e-7)));}
int digitMask(int d){if(d==0)return 63;if(d==1)return 6;if(d==2)return 91;if(d==3)return 79;if(d==4)return 102;if(d==5)return 109;if(d==6)return 125;if(d==7)return 7;if(d==8)return 127;return 111;}
float digitGlyph(float2 pix,float2 center,float sc,int d){float2 p=(pix-center)/max(sc*5.0,1.0);int m=digitMask(d);float v=0;float th=.13;if((m&1)!=0)v=max(v,saturate(1-sdSeg(p,float2(-.45,-.9),float2(.45,-.9))/th));if((m&2)!=0)v=max(v,saturate(1-sdSeg(p,float2(.5,-.82),float2(.5,-.08))/th));if((m&4)!=0)v=max(v,saturate(1-sdSeg(p,float2(.5,.08),float2(.5,.82))/th));if((m&8)!=0)v=max(v,saturate(1-sdSeg(p,float2(-.45,.9),float2(.45,.9))/th));if((m&16)!=0)v=max(v,saturate(1-sdSeg(p,float2(-.5,.08),float2(-.5,.82))/th));if((m&32)!=0)v=max(v,saturate(1-sdSeg(p,float2(-.5,-.82),float2(-.5,-.08))/th));if((m&64)!=0)v=max(v,saturate(1-sdSeg(p,float2(-.45,0),float2(.45,0))/th));return v;}
[numthreads(8,8,1)]void main(uint3 id:SV_DispatchThreadID){if(id.x>=(uint)_Resolution.x||id.y>=(uint)_Resolution.y)return;float2 uv=((float2)id.xy+.5)/_Resolution.xy;float2 ap=uv*float2(_Resolution.x/_Resolution.y,1);float3 col=0;float alpha=0;uint cnt=min((uint)_Data0_Count,192u);
[loop]for(uint i=0;i<192;i++){if(i>=cnt)break;PrimitiveRecord r=_Data0[i];if(r.active<.5)continue;float2 a=r.p0*float2(_Resolution.x/_Resolution.y,1),b=r.p1*float2(_Resolution.x/_Resolution.y,1);float d=r.kind<.5?sdSeg(ap,a,b):length(ap-a);float w=max(r.width*width_scale,0.0002);float core=saturate(1-d/w);float glowCov=pow(saturate(1-d/(w*(1+glow_radius*5))),2);float glyph=0;if(r.kind>1.5)glyph=digitGlyph((float2)id.xy,r.p0*_Resolution.xy,max(glyph_scale,1.0),(int)r.route_t%10);float pulse=1+0.16*sin(r.route_t*6.283+r.group_id*.37);float cov=max(max(core,glowCov*glow),glyph);col+=r.color*cov*intensity*pulse;alpha=max(alpha,saturate(cov));}
OutputUAV[id.xy]=float4(col,saturate(alpha));}
